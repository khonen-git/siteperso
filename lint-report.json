nst [isExpanded, setIsExpanded] = useTreeNodeState(item.href, isPathActive);\r\n\r\n  return (\r\n    <div role=\"treeitem\" aria-expanded={hasChildren ? isExpanded : undefined}>\r\n      <div\r\n        className={cn(\r\n          'flex items-center justify-between py-2 px-2',\r\n          level === 0 && 'rounded-md',\r\n          level > 0,\r\n          isActive && 'bg-accent text-accent-foreground font-medium',\r\n          !isActive && level === 0 && 'hover:bg-accent/50',\r\n          !isActive && level > 0 && 'hover:text-accent-foreground'\r\n        )}\r\n      >\r\n        {item.href ? (\r\n          <Link href={item.href} className=\"flex-1\" aria-current={isActive ? 'page' : undefined}>\r\n            {item.title}\r\n          </Link>\r\n        ) : (\r\n          <span className=\"flex-1\">{item.title}</span>\r\n        )}\r\n        {hasChildren && (\r\n          <button\r\n            onClick={() => setIsExpanded(!isExpanded)}\r\n            className=\"p-1 hover:bg-accent rounded-sm\"\r\n            aria-expanded={isExpanded}\r\n            aria-label={isExpanded ? t('collapseSection') : t('expandSection')}\r\n          >\r\n            <ChevronDown\r\n              className={cn(\r\n                'h-4 w-4 transition-transform',\r\n                isExpanded && 'transform rotate-180'\r\n              )}\r\n            />\r\n          </button>\r\n        )}\r\n      </div>\r\n      <div\r\n        className={cn('border-l ml-2 pl-1', !hasChildren || (!isExpanded && 'hidden'))}\r\n        role=\"group\"\r\n      >\r\n        {item.children?.map((child, index) => (\r\n          <TreeNode key={`${item.href}-${index}`} item={child} level={level + 1} />\r\n        ))}\r\n      </div>\r\n    </div>\r\n  );\r\n}\r\n\r\nexport function TreeView({ items }: TreeViewProps) {\r\n  return (\r\n    <div role=\"tree\" className=\"space-y-2\">\r\n      {items.map((item, index) => (\r\n        <TreeNode key={index} item={item} />\r\n      ))}\r\n    </div>\r\n  );\r\n}