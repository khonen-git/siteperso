/prettier","severity":2,"message":"Insert `,`","line":61,"column":4,"nodeType":null,"messageId":"insert","endLine":61,"endColumn":4,"fix":{"range":[1433,1433],"text":","}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `┬À` with `ÔÉìÔÅÄ`","line":62,"column":3,"nodeType":null,"messageId":"replace","endLine":62,"endColumn":4,"fix":{"range":[1437,1438],"text":"\r\n"}}],"suppressedMessages":[],"errorCount":19,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":19,"fixableWarningCount":0,"source":"import { DistributionConfig } from '@/types/distributions';\r\n\r\nfunction pdf(params: Record<string, number>, x: number): number {\r\n  const mu = params.mu;\r\n  const sigma = params.sigma;\r\n  return (1 / Math.sqrt(2 * Math.PI * Math.pow(sigma, 2))) * \r\n         Math.exp(-Math.pow(x - mu, 2) / (2 * Math.pow(sigma, 2)));\r\n}\r\n\r\nfunction cdf(params: Record<string, number>, x: number): number {\r\n  const mu = params.mu;\r\n  const sigma = params.sigma;\r\n  return 0.5 * (1 + erf((x - mu) / (sigma * Math.sqrt(2))));\r\n}\r\n\r\n// Approximation de la fonction d'erreur (erf)\r\nfunction erf(x: number): number {\r\n  const a1 =  0.254829592;\r\n  const a2 = -0.284496736;\r\n  const a3 =  1.421413741;\r\n  const a4 = -1.453152027;\r\n  const a5 =  1.061405429;\r\n  const p  =  0.3275911;\r\n\r\n  const sign = x < 0 ? -1 : 1;\r\n  x = Math.abs(x);\r\n\r\n  const t = 1.0 / (1.0 + p * x);\r\n  const y = 1.0 - (((((a5 * t + a4) * t) + a3) * t + a2) * t + a1) * t * Math.exp(-x * x);\r\n\r\n  return sign * y;\r\n}\r\n\r\nexport const normalDistribution: DistributionConfig = {\r\n  name: \"Loi Normale\",\r\n  parameters: [\r\n    {\r\n      name: \"mu\",\r\n      label: \"╬╝ (moyenne)\",\r\n      defaultValue: 0,\r\n      min: -5,\r\n      max: 5,\r\n      step: 0.1\r\n    },\r\n    {\r\n      name: \"sigma\",\r\n      label: \"¤â (├®cart-type)\",\r\n      defaultValue: 1,\r\n      min: 0.1,\r\n      max: 3,\r\n      step: 0.1\r\n    }\r\n  ],\r\n  range: {\r\n    min: -5,\r\n    max: 5\r\n  },\r\n  functions: {\r\n    pdf,\r\n    cdf\r\n  }\r\n}; ","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Utilisateur\\VSrepos\\SiteKhonen\\siteperso\\src\\lib\\finance\\__tests__\\blackScholes.test.ts","messages":[{"ruleId":"prettier/prettier","severity":2,"message":"Replace `ÔÉìÔÅÄ┬À┬ÀblackScholesGreeks,ÔÉìÔÅÄ┬À┬ÀblackScholesPrice,ÔÉìÔÅÄ┬À┬ÀintrinsicValue,ÔÉìÔÅÄ┬À┬ÀnormCdf,ÔÉìÔÅÄ` with `┬ÀblackScholesGreeks,┬ÀblackScholesPrice,┬ÀintrinsicValue,┬ÀnormCdf┬À`","line":1,"column":9,"nodeType":null,"messageId":"replace","endLine":6,"endColumn":1,"fix":{"range":[8,86],"text":" blackScholesGreeks, blackScholesPrice, intrinsicValue, normCdf "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `ÔÉìÔÅÄ┬À┬À┬À┬À┬À`","line":37,"column":19,"nodeType":null,"messageId":"insert","endLine":37,"endColumn":19,"fix":{"range":[974,974],"text":"\r\n     "}}],"suppressedMessages":[],"errorCount":2,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":2,"fixableWarningCount":0,"source":"import {\r\n  blackScholesGreeks,\r\n  blackScholesPrice,\r\n  intrinsicValue,\r\n  normCdf,\r\n} from '../blackScholes';\r\n\r\ndescribe('blackScholes', () => {\r\n  it('normCdf(0) is approximately 0.5', () => {\r\n    expect(normCdf(0)).toBeCloseTo(0.5, 2);\r\n  });\r\n\r\n  it('call price is above intrinsic when T > 0', () => {\r\n    const spot = 100;\r\n    const strike = 100;\r\n    const price = blackScholesPrice({\r\n      spot,\r\n      strike,\r\n      timeYears: 0.5,\r\n      rate: 0.05,\r\n      volatility: 0.2,\r\n      optionType: 'call',\r\n    });\r\n    expect(price).toBeGreaterThan(intrinsicValue(spot, strike, 'call'));\r\n  });\r\n\r\n  it('put-call parity holds approximately', () => {\r\n    const params = {\r\n      spot: 100,\r\n      strike: 100,\r\n      timeYears: 1,\r\n      rate: 0.05,\r\n      volatility: 0.25,\r\n    };\r\n    const call = blackScholesPrice({ ...params, optionType: 'call' as const });\r\n    const put = blackScholesPrice({ ...params, optionType: 'put' as const });\r\n    const parity = call - put - params.spot + params.strike * Math.exp(-params.rate * params.timeYears);\r\n    expect(Math.abs(parity)).toBeLessThan(0.01);\r\n  });\r\n\r\n  it('long call delta is between 0 and 1', () => {\r\n    const g = blackScholesGreeks({\r\n      spot: 100,\r\n      strike: 100,\r\n      timeYears: 0.25,\r\n      rate: 0.05,\r\n      volatility: 0.2,\r\n      optionType: 'call',\r\n    });\r\n    expect(g.delta).toBeGreaterThan(0);\r\n    expect(g.delta).toBeLessThan(1);\r\n  });\r\n});\r\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Utilisateur\\VSrepos\\SiteKhonen\\siteperso\\src\\lib\\finance\\blackScholes.ts","messages":[{"ruleId":"prettier/prettier","severity":2,"message":"Replace `ÔÉìÔÅÄ┬À┬À┬À┬Àt┬À*ÔÉìÔÅÄ┬À┬À┬À┬À(0.3193815┬À+ÔÉìÔÅÄ┬À┬À┬À┬À┬À` with `┬Àt┬À*┬À(0.3193815┬À+`","line":21,"column":8,"nodeType":null,"messageId":"replace","endLine":24,"endColumn":6,"fix":{"range":[550,584],"text":" t * (0.3193815 +"}},{"ruleId":"@typescript-eslint/explicit-function-return-type","severity":1,"message":"Missing return type on function.","line":28,"column":1,"nodeType":"FunctionDeclaration","messageId":"missingReturnType","endLine":28,"endColumn":14},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `ÔÉìÔÅÄ┬À┬À┬À`","line":91,"column":16,"nodeType":null,"messageId":"delete","endLine":92,"endColumn":4,"fix":{"range":[2955,2960],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `ÔÉìÔÅÄ┬À┬À┬À┬À┬À┬À┬À┬À┬À┬Àrate┬À*┬Àstrike┬À*┬Àdiscount┬À*┬ÀnormCdf(d2))┬À/ÔÉìÔÅÄ┬À┬À┬À┬À┬À┬À┬À` with `┬Àrate┬À*┬Àstrike┬À*┬Àdiscount┬À*┬ÀnormCdf(d2))┬À/`","line":98,"column":52,"nodeType":null,"messageId":"replace","endLine":100,"endColumn":8,"fix":{"range":[3175,3237],"text":" rate * strike * discount * normCdf(d2)) /"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `ÔÉìÔÅÄ┬À┬À┬À┬À┬À┬À┬À┬À┬À┬Àrate┬À*┬Àstrike┬À*┬Àdiscount┬À*┬ÀnormCdf(-d2))┬À/ÔÉìÔÅÄ┬À┬À┬À┬À┬À┬À┬À` with `┬Àrate┬À*┬Àstrike┬À*┬Àdiscount┬À*┬ÀnormCdf(-d2))┬À/`","line":101,"column":52,"nodeType":null,"messageId":"replace","endLine":103,"endColumn":8,"fix":{"range":[3294,3357],"text":" rate * strike * discount * normCdf(-d2)) /"}}],"suppressedMessages":[],"errorCount":4,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":4,"fixableWarningCount":0,"source":"export type OptionType = 'call' | 'put';\r\n\r\nexport interface BlackScholesParams {\r\n  spot: number;\r\n  strike: number;\r\n  timeYears: number;\r\n  rate: number;\r\n  volatility: number;\r\n  optionType: OptionType;\r\n}\r\n\r\nfunction normPdf(x: number): number {\r\n  return Math.exp(-0.5 * x * x) / Math.sqrt(2 * Math.PI);\r\n}\r\n\r\n/** Cumulative standard normal distribution (Abramowitz & Stegun). */\r\nexport function normCdf(x: number): number {\r\n  const t = 1 / (1 + 0.2316419 * Math.abs(x));\r\n  const d = 0.3989423 * Math.exp((-x * x) / 2);\r\n  const p =\r\n    d *\r\n    t *\r\n    (0.3193815 +\r\n      t * (-0.3565638 + t * (1.781478 + t * (-1.821256 + t * 1.330274))));\r\n  return x > 0 ? 1 - p : p;\r\n}\r\n\r\nfunction d1d2(spot: number, strike: number, timeYears: number, rate: number, volatility: number) {\r\n  const sqrtT = Math.sqrt(timeYears);\r\n  const d1 =\r\n    (Math.log(spot / strike) + (rate + 0.5 * volatility * volatility) * timeYears) /\r\n    (volatility * sqrtT);\r\n  const d2 = d1 - volatility * sqrtT;\r\n  return { d1, d2, sqrtT };\r\n}\r\n\r\n/** European BlackÔÇôScholes option price. */\r\nexport function blackScholesPrice(params: BlackScholesParams): number {\r\n  const { spot, strike, timeYears, rate, volatility, optionType } = params;\r\n  if (timeYears <= 0) {\r\n    return intrinsicValue(spot, strike, optionType);\r\n  }\r\n  if (spot <= 0 || strike <= 0 || volatility <= 0) {\r\n    return intrinsicValue(spot, strike, optionType);\r\n  }\r\n\r\n  const { d1, d2 } = d1d2(spot, strike, timeYears, rate, volatility);\r\n  const discount = Math.exp(-rate * timeYears);\r\n\r\n  if (optionType === 'call') {\r\n    return spot * normCdf(d1) - strike * discount * normCdf(d2);\r\n  }\r\n  return strike * discount * normCdf(-d2) - spot * normCdf(-d1);\r\n}\r\n\r\nexport function intrinsicValue(spot: number, strike: number, optionType: OptionType): number {\r\n  if (optionType === 'call') {\r\n    return Math.max(spot - strike, 0);\r\n  }\r\n  return Math.max(strike - spot, 0);\r\n}\r\n\r\nexport interface OptionGreeks {\r\n  delta: number;\r\n  gamma: number;\r\n  /** Theta per calendar day (option value change for +1 day). */\r\n  thetaPerDay: number;\r\n  /** Vega per 1 point of volatility (¤â = 0.20 ÔåÆ 1 point = +0.01 absolute). */\r\n  vegaPerVolPoint: number;\r\n}\r\n\r\n/** Greeks for a long option position (European BS). */\r\nexport function blackScholesGreeks(params: BlackScholesParams): OptionGreeks {\r\n  const { spot, strike, timeYears, rate, volatility, optionType } = params;\r\n\r\n  if (timeYears <= 1e-6 || spot <= 0 || strike <= 0 || volatility <= 0) {\r\n    const callItm = spot > strike ? 1 : spot < strike ? 0 : 0.5;\r\n    const putItm = spot < strike ? -1 : spot > strike ? 0 : -0.5;\r\n    return {\r\n      delta: optionType === 'call' ? callItm : putItm,\r\n      gamma: 0,\r\n      thetaPerDay: 0,\r\n      vegaPerVolPoint: 0,\r\n    };\r\n  }\r\n\r\n  const { d1, d2, sqrtT } = d1d2(spot, strike, timeYears, rate, volatility);\r\n  const pdf = normPdf(d1);\r\n  const discount = Math.exp(-rate * timeYears);\r\n\r\n  const delta =\r\n    optionType === 'call' ? normCdf(d1) : normCdf(d1) - 1;\r\n\r\n  const gamma = pdf / (spot * volatility * sqrtT);\r\n\r\n  const thetaPerYear =\r\n    optionType === 'call'\r\n      ? (-(spot * pdf * volatility) / (2 * sqrtT) -\r\n          rate * strike * discount * normCdf(d2)) /\r\n        365\r\n      : (-(spot * pdf * volatility) / (2 * sqrtT) +\r\n          rate * strike * discount * normCdf(-d2)) /\r\n        365;\r\n\r\n  const vegaPerVolPoint = (spot * pdf * sqrtT) / 100;\r\n\r\n  return {\r\n    delta,\r\n    gamma,\r\n    thetaPerDay: thetaPerYear,\r\n    vegaPerVolPoint,\r\n  };\r\n}\r\n\r\nexport function positionSign(isLong: boolean): number {\r\n  return isLong ? 1 : -1;\r\n}\r\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Utilisateur\\VSrepos\\SiteKhonen\\siteperso\\src\\lib\\finance\\optionCurves.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Utilisateur\\VSrepos\\SiteKhonen\\siteperso\\src\\lib\\knowledge\\ai-content-notice.ts","messages":[{"ruleId":"prettier/prettier","severity":2,"message":"Replace `path.startsWith('engineering/design-patterns')┬À||┬Àpath.startsWith('programming/design-patterns'` with `(ÔÉìÔÅÄ┬À┬À┬À┬Àpath.startsWith('engineering/design-patterns')┬À||┬Àpath.startsWith('programming/design-patterns')ÔÉìÔÅÄ┬À┬À`","line":9,"column":10,"nodeType":null,"messageId":"replace","endLine":9,"endColumn":105,"fix":{"range":[451,546],"text":"(\r\n    path.startsWith('engineering/design-patterns') || path.startsWith('programming/design-patterns')\r\n  "}}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":1,"fixableWarningCount":0,"source":"const AI_CONTENT_NOTICE_FR =\r\n  \"Nota bene : Ce contenu a ├®t├® g├®n├®r├® par IA. Je suis en train de travailler sur cette page pour proposer un contenu personnel et d'une meilleure qualit├®.\";\r\n\r\nconst AI_CONTENT_NOTICE_EN =\r\n  'Note: This content was generated by AI. I am working on this page to provide personal content of better quality.';\r\n\r\nexport function isDesignPatternsArticle(slug: string[]): boolean {\r\n  const path = slug.join('/');\r\n  return path.startsWith('engineering/design-patterns') || path.startsWith('programming/design-patterns');\r\n}\r\n\r\nexport function getAiContentNotice(locale: string): string {\r\n  return locale === 'en' ? AI_CONTENT_NOTICE_EN : AI_CO