render(<TestMdxContent />);\r\n\r\n    expect(screen.getByText('Normal Distribution Test')).toBeInTheDocument();\r\n    expect(screen.getByTestId('distribution-visualizer')).toBeInTheDocument();\r\n  });\r\n\r\n  it('keeps store state across MDX navigation rerenders', () => {\r\n    const { rerender } = render(<TestMdxContent />);\r\n\r\n    const store = useDistributionStore.getState();\r\n    act(() => {\r\n      store.addCurve(sampleCurve);\r\n    });\r\n\r\n    rerender(<TestMdxContent />);\r\n\r\n    expect(store.curves).toHaveLength(1);\r\n    expect(store.curves[0].params).toEqual({ mu: 0, sigma: 1 });\r\n  });\r\n\r\n  it('handles preset interactions', async () => {\r\n    render(<TestMdxContent />);\r\n\r\n    const input = screen.getByPlaceholderText('Nom du preset');\r\n    const saveButton = screen.getByText('Sauvegarder');\r\n\r\n    fireEvent.change(input, { target: { value: 'My Preset' } });\r\n    fireEvent.click(saveButton);\r\n\r\n    const store = useDistributionStore.getState();\r\n    expect(store.presets).toHaveLength(1);\r\n    expect(store.presets[0].name).toBe('My Preset');\r\n  });\r\n\r\n  it('exposes distribution math functions on the store', () => {\r\n    render(<TestMdxContent />);\r\n\r\n    const store = useDistributionStore.getState();\r\n    expect(store.activeDistribution).toBeDefined();\r\n    expect(typeof store.activeDistribution?.functions.pdf).toBe('function');\r\n    expect(typeof store.activeDistribution?.functions.cdf).toBe('function');\r\n  });\r\n\r\n  describe('Performance in MDX context', () => {\r\n    it('stays fast across repeated updates', () => {\r\n      const { rerender } = render(<TestMdxContent />);\r\n\r\n      const start = performance.now();\r\n\r\n      for (let i = 0; i < 10; i++) {\r\n        act(() => {\r\n          const store = useDistributionStore.getState();\r\n          store.setFunctionType(i % 2 === 0 ? 'pdf' : 'cdf');\r\n        });\r\n        rerender(<TestMdxContent />);\r\n      }\r\n\r\n      const end = performance.now();\r\n      const averageUpdateTime = (end - start) / 10;\r\n\r\n      expect(averageUpdateTime).toBeLessThan(50);\r\n    });\r\n  });\r\n});\r\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Utilisateur\\VSrepos\\SiteKhonen\\siteperso\\src\\components\\mdx\\__tests__\\MdxDistributionVisualizer.test.tsx","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":1,"message":"'fireEvent' is defined but never used.","line":2,"column":26,"nodeType":"Identifier","messageId":"unusedVar","endLine":2,"endColumn":35},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `ÔÉìÔÅÄ┬À┬À┬À┬À┬À┬À<MdxDistributionVisualizerÔÉìÔÅÄ┬À┬À┬À┬À┬À┬À┬À┬Àdistribution={normalDistribution}ÔÉìÔÅÄ┬À┬À┬À┬À┬À┬À┬À┬ÀshowPresets={true}ÔÉìÔÅÄ┬À┬À┬À┬À┬À┬À/>ÔÉìÔÅÄ┬À┬À┬À┬À` with `<MdxDistributionVisualizer┬Àdistribution={normalDistribution}┬ÀshowPresets={true}┬À/>`","line":26,"column":12,"nodeType":null,"messageId":"replace","endLine":31,"endColumn":5,"fix":{"range":[1118,1239],"text":"<MdxDistributionVisualizer distribution={normalDistribution} showPresets={true} />"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `ÔÉìÔÅÄ┬À┬À┬À┬À┬À┬À<MdxDistributionVisualizer┬Àdistribution={normalDistribution}┬À/>ÔÉìÔÅÄ┬À┬À┬À┬À` with `<MdxDistributionVisualizer┬Àdistribution={normalDistribution}┬À/>`","line":36,"column":34,"nodeType":null,"messageId":"replace","endLine":38,"endColumn":5,"fix":{"range":[1402,1479],"text":"<MdxDistributionVisualizer distribution={normalDistribution} />"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `ÔÉìÔÅÄ┬À┬À┬À┬À┬À┬À<MdxDistributionVisualizerÔÉìÔÅÄ┬À┬À┬À┬À┬À┬À┬À┬Àdistribution={normalDistribution}ÔÉìÔÅÄ┬À┬À┬À┬À┬À┬À┬À┬ÀshowPresets={true}ÔÉìÔÅÄ┬À┬À┬À┬À┬À┬À/>ÔÉìÔÅÄ┬À┬À┬À┬À` with `<MdxDistributionVisualizer┬Àdistribution={normalDistribution}┬ÀshowPresets={true}┬À/>`","line":45,"column":12,"nodeType":null,"messageId":"replace","endLine":50,"endColumn":5,"fix":{"range":[1668,1789],"text":"<MdxDistributionVisua