e=\"prose prose-gray dark:prose-invert max-w-none space-y-4\">\r\n                <p>{t(textKey)}</p>\r\n              </div>\r\n            </section>\r\n          ))}\r\n        </div>\r\n      </main>\r\n\r\n      <aside className=\"hidden w-64 shrink-0 border-l bg-background/95 backdrop-blur supports-[backdrop-filter]:bg-background/60 xl:block\">\r\n        <ScrollArea className=\"h-full px-4 py-6\">\r\n          <div className=\"space-y-4\">\r\n            <h3 className=\"text-sm font-semibold\">{tLayout('tocTitle')}</h3>\r\n            <TableOfContents className=\"text-sm\" />\r\n          </div>\r\n        </ScrollArea>\r\n      </aside>\r\n    </div>\r\n  );\r\n}\r\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Utilisateur\\VSrepos\\SiteKhonen\\siteperso\\src\\components\\features\\knowledge\\KnowledgeMdxRenderer.tsx","messages":[{"ruleId":"prettier/prettier","severity":2,"message":"Replace `ÔÉìÔÅÄ┬À┬ÀgetAiContentNotice,ÔÉìÔÅÄ┬À┬ÀisDesignPatternsArticle,ÔÉìÔÅÄ` with `┬ÀgetAiContentNotice,┬ÀisDesignPatternsArticle┬À`","line":7,"column":9,"nodeType":null,"messageId":"replace","endLine":10,"endColumn":1,"fix":{"range":[251,304],"text":" getAiContentNotice, isDesignPatternsArticle "}}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":1,"fixableWarningCount":0,"source":"'use client';\r\n\r\nimport * as React from 'react';\r\nimport { NotaBene } from '@/components/mdx/NotaBene';\r\nimport { KnowledgeMdxProvider } from '@/components/mdx/KnowledgeMdxContext';\r\nimport { TooltipProvider } from '@/components/ui/tooltip';\r\nimport {\r\n  getAiContentNotice,\r\n  isDesignPatternsArticle,\r\n} from '@/lib/knowledge/ai-content-notice';\r\n\r\ninterface KnowledgeMdxRendererProps {\r\n  locale: string;\r\n  slug: string[];\r\n  children: React.ReactNode;\r\n}\r\n\r\nexport function KnowledgeMdxRenderer({\r\n  locale,\r\n  slug,\r\n  children,\r\n}: KnowledgeMdxRendererProps): React.JSX.Element {\r\n  const showAiNotice 