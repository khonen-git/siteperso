'respects TTL', () => {\r\n    const ttl = 1000;\r\n    const { result } = renderHook(() => useCalculationCache<number>({ ttl }));\r\n\r\n    const key = result.current.generateKey({ test: 1 });\r\n    act(() => {\r\n      result.current.set(key, 42);\r\n    });\r\n\r\n    expect(result.current.get(key)).toBe(42);\r\n\r\n    act(() => {\r\n      jest.advanceTimersByTime(ttl + 100);\r\n    });\r\n\r\n    expect(result.current.get(key)).toBeUndefined();\r\n  });\r\n\r\n  it('clears the cache', () => {\r\n    const { result } = renderHook(() => useCalculationCache<number>());\r\n\r\n    const key = result.current.generateKey({ test: 1 });\r\n    act(() => {\r\n      result.current.set(key, 42);\r\n    });\r\n\r\n    expect(result.current.get(key)).toBe(42);\r\n\r\n    act(() => {\r\n      result.current.clear();\r\n    });\r\n\r\n    expect(result.current.get(key)).toBeUndefined();\r\n  });\r\n\r\n  it('generates identical keys for the same params regardless of key order', () => {\r\n    const { result } = renderHook(() => useCalculationCache<number>());\r\n\r\n    const key1 = result.current.generateKey({ a: 1, b: 2 });\r\n    const key2 = result.current.generateKey({ b: 2, a: 1 });\r\n    const key3 = result.current.generateKey({ a: 1, b: 3 });\r\n\r\n    expect(key1).toBe(key2);\r\n    expect(key1).not.toBe(key3);\r\n  });\r\n});\r\n","usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Utilisateur\\VSrepos\\SiteKhonen\\siteperso\\src\\hooks\\__tests__\\useDistributionCalculator.test.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Users\\Utilisateur\\VSrepos\\SiteKhonen\\siteperso\\src\\hooks\\useCalculationCache.ts","messages":[{"ruleId":"@typescript-eslint/explicit-function-return-type","severity":1,"message":"Missing return type on function.","line":14,"column":8,"nodeType":"FunctionDeclaration","messageId":"missingReturnType","endLi